# Copy to /opt/kibanaalerting/config.env and fill in your values.
# Never commit the real config.env.

# Discord webhook to post alerts to
WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# Kibana JSON log file to watch
LOG_FILE_PATH=/var/log/kibana/kibana.log

# Value of log.logger that identifies alert entries
TARGET_MESSAGE=plugins.actions.server-log

# Where this script writes its own logs
APPLICATION_LOG_FILE_PATH=/var/log/kibanaalerting/kibanaalert.log
